      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "qps_train_loss{run=~\"$experiment\",attempt=~\"$attempt\",allocation=~\"$allocation\",worker_group=~\"$worker_group\"}",
          "legendFormat": "{{run}} / a{{attempt}} / {{gpu}} / rank {{rank}} {{phase}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
