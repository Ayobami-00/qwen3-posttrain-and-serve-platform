      },
      "targets": [
        {
          "refId": "A",
          "expr": "qps_gpu_temperature_celsius{run=~\"$experiment\",attempt=~\"$attempt\",allocation=~\"$allocation\",worker_group=~\"$worker_group\",gpu=~\"$gpu\"}",
          "legendFormat": "{{run}} / a{{attempt}} / {{gpu}} / rank {{rank}} {{phase}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius"
