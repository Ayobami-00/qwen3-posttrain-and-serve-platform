      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "qps_gpu_memory_total_bytes{run=~\"$experiment\",attempt=~\"$attempt\",allocation=~\"$allocation\",worker_group=~\"$worker_group\",gpu=~\"$gpu\"}",
          "legendFormat": "{{run}} / a{{attempt}} / {{gpu}} / rank {{rank}} {{phase}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
