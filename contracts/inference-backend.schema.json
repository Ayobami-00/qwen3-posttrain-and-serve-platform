{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qps:inference-backend:v1",
  "title": "InferenceBackendCapability",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "artifactKind",
    "manifestVersions",
    "weightFormats",
    "weightLayouts",
    "storedWeightDtypes",
    "modelProfiles",
    "promptProfiles",
    "executionProfiles",
    "generationModes",
    "maxContextTokens",
    "maxOutputTokens",
    "maxActiveGenerations",
    "streaming",
    "httpContract"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{0,79}$"
    },
    "artifactKind": {
      "type": "string",
      "const": "merged_model"
    },
    "manifestVersions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "const": 1
      }
    },
    "weightFormats": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "const": "safetensors"
      }
    },
    "weightLayouts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "const": "single_file"
      }
    },
    "storedWeightDtypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "fp32",
          "bf16"
        ]
      }
    },
    "modelProfiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9.-]{0,79}$"
      }
    },
    "promptProfiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9.-]{0,79}$"
      }
    },
    "executionProfiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "device",
          "dtype",
          "tensorParallelSize"
        ],
        "properties": {
          "device": {
            "type": "string",
            "enum": [
              "cpu",
              "cuda"
            ]
          },
          "dtype": {
            "type": "string",
            "enum": [
              "fp32",
              "bf16"
            ]
          },
          "tensorParallelSize": {
            "type": "integer",
            "enum": [
              1,
              2
            ]
          }
        },
        "$comment": "This describes execution intent. An entry must match an advertised backend execution profile; schema validity alone does not establish device or topology support."
      }
    },
    "generationModes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "const": "greedy"
      }
    },
    "maxContextTokens": {
      "type": "integer",
      "minimum": 16,
      "maximum": 2048
    },
    "maxOutputTokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 512
    },
    "maxActiveGenerations": {
      "type": "integer",
      "minimum": 1
    },
    "streaming": {
      "type": "boolean"
    },
    "httpContract": {
      "type": "string",
      "const": "qps-openai-subset-v1"
    }
  }
}
