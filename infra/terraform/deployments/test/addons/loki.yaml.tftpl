deploymentMode: SingleBinary
loki:
  auth_enabled: false
  commonConfig: {replication_factor: 1}
  schemaConfig:
    configs:
      - from: "2026-01-01"
        store: tsdb
        object_store: s3
        schema: v13
        index: {prefix: qps_, period: 24h}
  storage:
    type: s3
    bucketNames: {chunks: "${bucket}", ruler: "${bucket}", admin: "${bucket}"}
    s3: {region: "${region}", s3ForcePathStyle: false}
  limits_config:
    retention_period: 24h
    ingestion_rate_mb: 2
    ingestion_burst_size_mb: 4
    allow_structured_metadata: true
  compactor:
    retention_enabled: true
    delete_request_store: s3
serviceAccount: {create: true, name: qps-loki}
singleBinary:
  replicas: 1
  persistence: {enabled: true, storageClass: gp3, size: 5Gi}
  resources:
    requests: {cpu: 150m, memory: 256Mi}
    limits: {memory: 768Mi}
read: {replicas: 0}
write: {replicas: 0}
backend: {replicas: 0}
chunksCache: {enabled: false}
resultsCache: {enabled: false}
lokiCanary: {enabled: false}
test: {enabled: false}
gateway:
  replicas: 1
  resources:
    requests: {cpu: 25m, memory: 32Mi}
    limits: {memory: 128Mi}
